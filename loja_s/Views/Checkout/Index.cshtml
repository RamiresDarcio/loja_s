@model loja_s.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="checkout-shell">
    <div class="checkout-content">
        <div class="checkout-section">
            <h1>Checkout</h1>
            <form asp-action="Index" method="post" class="checkout-form">
                @Html.AntiForgeryToken()

                <div class="step-panel">
                    <h3>1. Identificação</h3>
                    <div class="form-grid two-col">
                        <div class="field">
                            <label asp-for="NomeCompleto">Nome completo</label>
                            <input asp-for="NomeCompleto" />
                            <span asp-validation-for="NomeCompleto" class="validation-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="CPF">CPF</label>
                            <input asp-for="CPF" />
                            <span asp-validation-for="CPF" class="validation-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Email">E-mail</label>
                            <input asp-for="Email" type="email" />
                            <span asp-validation-for="Email" class="validation-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Telefone">Telefone</label>
                            <input asp-for="Telefone" />
                            <span asp-validation-for="Telefone" class="validation-error"></span>
                        </div>
                    </div>
                </div>

                <div class="step-panel">
                    <h3>2. Endereço</h3>
                    <div class="form-grid two-col">
                        <div class="field">
                            <label asp-for="CEP">CEP</label>
                            <input asp-for="CEP" />
                            <span asp-validation-for="CEP" class="validation-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Rua">Rua</label>
                            <input asp-for="Rua" />
                            <span asp-validation-for="Rua" class="validation-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Numero">Número</label>
                            <input asp-for="Numero" />
                            <span asp-validation-for="Numero" class="validation-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Complemento">Complemento</label>
                            <input asp-for="Complemento" />
                        </div>
                        <div class="field">
                            <label asp-for="Bairro">Bairro</label>
                            <input asp-for="Bairro" />
                            <span asp-validation-for="Bairro" class="validation-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Cidade">Cidade</label>
                            <input asp-for="Cidade" />
                            <span asp-validation-for="Cidade" class="validation-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="Estado">Estado</label>
                            <input asp-for="Estado" />
                            <span asp-validation-for="Estado" class="validation-error"></span>
                        </div>
                    </div>
                </div>

                <div class="step-panel">
                    <h3>3. Pagamento</h3>
                    <div class="payment-options">
                        <label><input type="radio" asp-for="FormaPagamento" value="PIX" checked /> PIX</label>
                        <label><input type="radio" asp-for="FormaPagamento" value="CartaoCredito" /> Cartão de crédito</label>
                        <label><input type="radio" asp-for="FormaPagamento" value="CartaoDebito" /> Cartão de débito</label>
                        <label><input type="radio" asp-for="FormaPagamento" value="Boleto" /> Boleto</label>
                    </div>
                    <div class="payment-note">
                        <input asp-for="AceitaTermos" type="checkbox" />
                        <label asp-for="AceitaTermos">Confirmo que os dados estão corretos e aceito os termos do pedido.</label>
                    </div>
                    <span asp-validation-for="AceitaTermos" class="validation-error"></span>
                </div>

                <button type="submit" class="primary-btn full">Finalizar compra</button>
            </form>
        </div>

        <aside class="checkout-summary">
            <h2>Resumo do pedido</h2>
            @foreach (var item in Model.Itens)
            {
                <div class="summary-item">
                    <span>@item.Nome x @item.Quantidade</span>
                    <strong>R$ @item.Subtotal.ToString("N2")</strong>
                </div>
            }
            <div class="summary-row"><span>Subtotal</span><strong>R$ @Model.Subtotal.ToString("N2")</strong></div>
            <div class="summary-row"><span>Frete</span><strong>R$ @Model.Frete.ToString("N2")</strong></div>
            <div class="summary-row"><span>Desconto</span><strong>R$ @Model.Desconto.ToString("N2")</strong></div>
            <div class="summary-row total"><span>Total</span><strong>R$ @Model.ValorTotal.ToString("N2")</strong></div>
        </aside>
    </div>
</div>

<link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
