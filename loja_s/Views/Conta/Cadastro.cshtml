@model loja_s.ViewModels.CadastroContaViewModel
@{
    ViewData["Title"] = "Criar conta";
}

<section class="auth-card registration-card">
    <div class="auth-copy">
        <p class="account-eyebrow">Conta do cliente</p>
        <h1>Crie sua conta</h1>
        <p>Tenha seus pedidos, endereços e preferências em um só lugar.</p>
    </div>
    <form asp-action="Cadastro" method="post" class="account-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="account-form-grid">
            <div class="account-field">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" autocomplete="given-name" />
                <span asp-validation-for="Nome"></span>
            </div>
            <div class="account-field">
                <label asp-for="Sobrenome"></label>
                <input asp-for="Sobrenome" autocomplete="family-name" />
                <span asp-validation-for="Sobrenome"></span>
            </div>
            <div class="account-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="account-field">
                <label asp-for="Telefone"></label>
                <input asp-for="Telefone" autocomplete="tel" />
                <span asp-validation-for="Telefone"></span>
            </div>
            <div class="account-field">
                <label asp-for="DataNascimento"></label>
                <input asp-for="DataNascimento" />
                <span asp-validation-for="DataNascimento"></span>
            </div>
            <div class="account-field">
                <label asp-for="Senha"></label>
                <input asp-for="Senha" autocomplete="new-password" />
                <span asp-validation-for="Senha"></span>
                <small>Mínimo de 10 caracteres, com maiúscula, minúscula, número e símbolo.</small>
            </div>
            <div class="account-field">
                <label asp-for="ConfirmarSenha"></label>
                <input asp-for="ConfirmarSenha" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarSenha"></span>
            </div>
        </div>
        <label class="account-checkbox terms-check">
            <input asp-for="AceitouTermos" />
            <span>Aceito os termos de uso e a política de privacidade.</span>
        </label>
        <span asp-validation-for="AceitouTermos" class="field-error"></span>
        <button class="account-button primary" type="submit">Criar conta</button>
        <p class="auth-switch">Já tem uma conta? <a asp-action="Login">Entrar</a></p>
    </form>
</section>
