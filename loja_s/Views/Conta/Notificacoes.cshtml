@model loja_s.ViewModels.PreferenciasNotificacaoViewModel
@{
    ViewData["Title"] = "Notificações";
}
<div class="account-page-heading">
    <div><p class="account-eyebrow">Minha conta</p><h1>Preferências de notificações</h1></div>
    <a class="account-button secondary" asp-action="MinhaConta">Voltar à conta</a>
</div>
<section class="account-panel">
    <form asp-action="Notificacoes" method="post" class="account-form">
        <p>Escolha as categorias de comunicação que deseja receber.</p>
        <label class="account-checkbox"><input asp-for="AtualizacoesPedidos" /><span>@Html.DisplayNameFor(m => m.AtualizacoesPedidos)</span></label>
        <label class="account-checkbox"><input asp-for="Promocoes" /><span>@Html.DisplayNameFor(m => m.Promocoes)</span></label>
        <label class="account-checkbox"><input asp-for="Novidades" /><span>@Html.DisplayNameFor(m => m.Novidades)</span></label>
        <label class="account-checkbox"><input asp-for="ProdutosFavoritos" /><span>@Html.DisplayNameFor(m => m.ProdutosFavoritos)</span></label>
        <label class="account-checkbox"><input asp-for="AlertasSeguranca" /><span>@Html.DisplayNameFor(m => m.AlertasSeguranca)</span></label>
        <button class="account-button primary" type="submit">Salvar preferências</button>
    </form>
</section>
<section class="account-panel">
    <h2>Notificações recentes</h2>
    @if (Model.Notificacoes.Count == 0)
    {
        <p>Você ainda não tem notificações.</p>
    }
    else
    {
        <div class="session-list">
            @foreach (var notificacao in Model.Notificacoes)
            {
                <article class="session-entry">
                    <div>
                        <strong>@notificacao.Titulo</strong>
                        <p>@notificacao.Mensagem</p>
                        <small>@notificacao.CriadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        @if (!string.IsNullOrWhiteSpace(notificacao.Url) && Url.IsLocalUrl(notificacao.Url))
                        {
                            <p><a class="text-link" href="@notificacao.Url">Ver detalhes</a></p>
                        }
                    </div>
                    @if (notificacao.LidaEm == null)
                    {
                        <form asp-action="MarcarNotificacaoComoLida" method="post">
                            <input type="hidden" name="id" value="@notificacao.Id" />
                            <button class="account-button secondary" type="submit">Marcar como lida</button>
                        </form>
                    }
                    else
                    {
                        <small>Lida</small>
                    }
                </article>
            }
        </div>
    }
</section>
