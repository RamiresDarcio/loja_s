@{
    Layout = null;
    ViewData["Title"] = "Loja de Suplementos - Home";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/paginal_i.css" asp-append-version="true">
</head>
<body>

    <!-- Cabeçalho -->
    <header class="header">
        <div class="logo">logo</div>
        <div class="search-bar">
            <input type="text">
            <button class="search-btn"></button>
        </div>
        <div class="user-actions">
            <a asp-controller="Home" asp-action="Login" class="icon-user">👤</a>
            <a href="#" class="icon-cart">🛒</a>
        </div>
    </header>

    <!-- Carrossel de Destaque -->
    <section class="carousel" data-carousel aria-label="Produtos em destaque">
        <div class="carousel-track">
            <article class="carousel-slide is-active"
                     aria-roledescription="slide"
                     aria-label="1 de 3"
                     aria-hidden="false">
                <a class="carousel-banner-link"
                   asp-controller="Home"
                   asp-action="Produto_1"
                   aria-label="Ver produto Bowsette Edition">
                    <img class="carousel-banner-image"
                         src="~/img/banner/bowsette%20edition.png"
                         alt="Creatina Power Dragon Bowsette Edition, suplemento para força, energia e desempenho." />
                </a>
            </article>

            <article class="carousel-slide"
                     aria-roledescription="slide"
                     aria-label="2 de 3"
                     aria-hidden="true"
                     inert>
                <a class="carousel-banner-link"
                   asp-controller="Home"
                   asp-action="Produto_3"
                   aria-label="Ver produto Juri Edition">
                    <img class="carousel-banner-image"
                         src="~/img/banner/juri%20edition.png"
                         alt="Multivitamínico Chaos Energy Juri Edition, com vitaminas e minerais para complementar a alimentação." />
                </a>
            </article>

            <article class="carousel-slide"
                     aria-roledescription="slide"
                     aria-label="3 de 3"
                     aria-hidden="true"
                     inert>
                <a class="carousel-banner-link"
                   asp-controller="Home"
                   asp-action="Produto_4"
                   aria-label="Ver produto Nami Edition">
                    <img class="carousel-banner-image"
                         src="~/img/banner/nani%20edition.png"
                         alt="Suplemento Blue Sea Omega 3 Nami Edition, com EPA e DHA para complementar a rotina de bem-estar." />
                </a>
            </article>
        </div>

        <button class="carousel-control carousel-previous" type="button" aria-label="Banner anterior">
            <span aria-hidden="true">‹</span>
        </button>
        <button class="carousel-control carousel-next" type="button" aria-label="Próximo banner">
            <span aria-hidden="true">›</span>
        </button>

        <div class="carousel-footer">
            <div class="carousel-thumbs" aria-label="Escolher banner">
                <button class="thumb is-active" type="button" aria-label="Mostrar banner Bowsette Edition" aria-current="true" data-slide-to="0"></button>
                <button class="thumb" type="button" aria-label="Mostrar banner Juri Edition" aria-current="false" data-slide-to="1"></button>
                <button class="thumb" type="button" aria-label="Mostrar banner Nami Edition" aria-current="false" data-slide-to="2"></button>
            </div>
            <button class="carousel-toggle" type="button" aria-label="Pausar troca automática" aria-pressed="false">Ⅱ</button>
        </div>
    </section>

    <main class="product-grid">
        <div class="products-heading">
            <h1>Nossos produtos</h1>
            <p>Encontre o suplemento ideal para sua rotina.</p>
        </div>

        <article class="product-card">
            <div class="product-img"><img src="~/img/produtos/produtos_1.png" alt="Power Dragon Creatine — Bowsette Edition" /></div>
            <div class="product-info">
                <span class="producer"><a asp-controller="Home" asp-action="Produto_1">Power Dragon Creatine — Bowsette Edition</a></span>
                <span class="price">R$ 0,00</span>
                <a class="buy-btn" asp-controller="Home" asp-action="Produto_1">COMPRAR</a>
            </div>
        </article>
        <article class="product-card">
            <div class="product-img"><img src="~/img/produtos/produtos_8.png" alt="Dark Warrior Whey — Baiken Edition" /></div>
            <div class="product-info">
                <span class="producer"><a asp-controller="Home" asp-action="Produto_2">Dark Warrior Whey — Baiken Edition</a></span>
                <span class="price">R$ 0,00</span>
                <a class="buy-btn" asp-controller="Home" asp-action="Produto_2">COMPRAR</a>
            </div>
        </article>
        <article class="product-card">
            <div class="product-img"><img src="~/img/produtos/produtos_3.png" alt="Chaos Energy Multi — Juri Edition" /></div>
            <div class="product-info">
                <span class="producer"><a asp-controller="Home" asp-action="Produto_3">Chaos Energy Multi — Juri Edition</a></span>
                <span class="price">R$ 0,00</span>
                <a class="buy-btn" asp-controller="Home" asp-action="Produto_3">COMPRAR</a>
            </div>
        </article>
        <article class="product-card">
            <div class="product-img"><img src="~/img/banner/nani%20edition.png" alt="Blue Sea Omega 3 — Nami Edition" /></div>
            <div class="product-info">
                <span class="producer"><a asp-controller="Home" asp-action="Produto_4">Blue Sea Omega 3 — Nami Edition</a></span>
                <span class="price">R$ 0,00</span>
                <a class="buy-btn" asp-controller="Home" asp-action="Produto_4">COMPRAR</a>
            </div>
        </article>
        <article class="product-card">
            <div class="product-img"><img src="~/img/produtos/produtos_7.png" alt="Mystic Balance Magnesium — Mystique Edition" /></div>
            <div class="product-info">
                <span class="producer"><a asp-controller="Home" asp-action="Produto_5">Mystic Balance Magnesium — Mystique Edition</a></span>
                <span class="price">R$ 0,00</span>
                <a class="buy-btn" asp-controller="Home" asp-action="Produto_5">COMPRAR</a>
            </div>
        </article>
        <article class="product-card">
            <div class="product-img"><img src="~/img/produtos/produtos_2.png" alt="Street Power D3 + K2 — CJ Edition" /></div>
            <div class="product-info">
                <span class="producer"><a asp-controller="Home" asp-action="Produto_6">Street Power D3 + K2 — CJ Edition</a></span>
                <span class="price">R$ 0,00</span>
                <a class="buy-btn" asp-controller="Home" asp-action="Produto_6">COMPRAR</a>
            </div>
        </article>
        <article class="product-card">
            <div class="product-img"><img src="~/img/produtos/produtos_5.png" alt="Mystery Recovery Glutamine — Scooby-Doo Edition" /></div>
            <div class="product-info">
                <span class="producer"><a asp-controller="Home" asp-action="Produto_7">Mystery Recovery Glutamine — Scooby-Doo Edition</a></span>
                <span class="price">R$ 0,00</span>
                <a class="buy-btn" asp-controller="Home" asp-action="Produto_7">COMPRAR</a>
            </div>
        </article>
        <article class="product-card">
            <div class="product-img product-img-pending" aria-label="Imagem do produto ainda não disponível"><span>Imagem em breve</span></div>
            <div class="product-info">
                <span class="producer"><a asp-controller="Home" asp-action="Produto_8">Produto 8 — Scooby-Doo Edition</a></span>
                <span class="price">R$ 0,00</span>
                <a class="buy-btn" asp-controller="Home" asp-action="Produto_8">COMPRAR</a>
            </div>
        </article>
    </main>
    <!-- Rodapé -->
    <footer class="footer">
        <div class="payment-methods">💳 Métodos de Pagamento</div>
        <div class="footer-info">
            <h3>Informações</h3>
        </div>
        <div class="footer-contact">
            <h3>central de atendimentos</h3>
            <p>61 99999-9999</p>
            <p>e-mail</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>