@model loja_s.Models.Produto
@{
    ViewData["Title"] = Model.Nome;
    Layout = "_ContaLayout";
}
<a class="text-link" asp-controller="Home" asp-action="Index">← Voltar à loja</a>
<article class="account-panel product-detail-layout">
        @if (!string.IsNullOrWhiteSpace(Model.ImagemUrl))
        {
            <img src="@Url.Content(Model.ImagemUrl)" alt="@Model.Nome" />
        }
        <div>
            <p class="account-eyebrow">Produto</p>
            <h1>@Model.Nome</h1>
            <p>@Model.Descricao</p>
            @if (Model.PrecoEfetivo < Model.Preco)
            {
                <p class="product-price-old">R$ @Model.Preco.ToString("N2")</p>
            }
            <p class="account-price">R$ @Model.PrecoEfetivo.ToString("N2")</p>
            <p>@(Model.Estoque > 0 ? $"Em estoque: {Model.Estoque}" : "Indisponível")</p>
            @if (Model.Estoque > 0)
            {
                <form asp-controller="Carrinho" asp-action="Adicionar" method="post" class="account-actions">
                    <input type="hidden" name="produtoId" value="@Model.Id" />
                    <input type="hidden" name="quantidade" value="1" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("VerProduto", "Home", new { id = Model.Id })" />
                    <button class="account-button primary" type="submit">Adicionar ao carrinho</button>
                </form>
            }
            <form asp-controller="Favoritos" asp-action="Adicionar" method="post" class="account-actions">
                <input type="hidden" name="produtoId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Url.Action("VerProduto", "Home", new { id = Model.Id })" />
                <button class="account-button secondary" type="submit">Adicionar aos favoritos</button>
            </form>
        </div>
 </article>
 @{
     var relacionados = ViewBag.Relacionados as IEnumerable<loja_s.Models.Produto>
         ?? Enumerable.Empty<loja_s.Models.Produto>();
 }
 @if (relacionados.Any())
 {
     <section class="account-panel related-products">
         <h2>Você também pode gostar</h2>
         <div class="related-products-grid">
             @foreach (var produto in relacionados)
             {
                 <a class="related-product-card" asp-action="VerProduto" asp-route-id="@produto.Id">
                     @if (!string.IsNullOrWhiteSpace(produto.ImagemUrl))
                     {
                         <img src="@Url.Content(produto.ImagemUrl)" alt="" />
                     }
                     <strong>@produto.Nome</strong>
                     <span>R$ @produto.PrecoEfetivo.ToString("N2")</span>
                 </a>
             }
         </div>
     </section>
 }
