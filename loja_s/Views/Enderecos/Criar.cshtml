@model loja_s.ViewModels.EnderecoContaViewModel
@{
    ViewData["Title"] = "Adicionar endereço";
}
<div class="account-page-heading"><div><p class="account-eyebrow">Minha conta</p><h1>Adicionar endereço</h1></div><a class="account-button secondary" asp-action="Index">Voltar</a></div>
<section class="account-panel">
    <form asp-action="Criar" method="post" class="account-form">
        <partial name="_EnderecoForm" model="Model" />
        <button class="account-button primary" type="submit">Salvar endereço</button>
    </form>
</section>
