@model bow.estoque.Models.Produto
@{ ViewData["Title"] = "Desativar produto"; }
<div class="panel danger-panel"><h1>Desativar produto</h1><p>Deseja desativar <strong>@Model.Nome</strong>? O produto deixa de ser oferecido, mas seu histórico de vendas e movimentações será preservado.</p><form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><button type="submit" class="btn danger">Confirmar desativação</button><a asp-action="Index" class="btn">Cancelar</a></form></div>
